@* Esta vista recibe una LISTA de clientes (lo que mandó el controlador) *@
@model IEnumerable<GestionClientes.Models.Cliente>

@{
    // Título de la pestaña del navegador (lo usa _Layout.cshtml)
    ViewData["Title"] = "Clientes";
}

<h1>Clientes</h1>

@* Si la lista está vacía, muestra un aviso *@
@if (!Model.Any())
{
    <div class="alert alert-info">Todavía no hay clientes.</div>
}
else
{
    @* Tabla con clases de Bootstrap *@
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Email</th>
                <th>Teléfono</th>
                <th>Fecha de alta</th>
            </tr>
        </thead>
        <tbody>
            @* Recorre la lista: una fila <tr> por cada cliente *@
            @foreach (var cliente in Model)
            {
                <tr>
                    <td>@cliente.Nombre</td>
                    <td>@cliente.Email</td>
                    <td>@cliente.Telefono</td>
                    <td>@cliente.FechaAlta.ToString("dd/MM/yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
}